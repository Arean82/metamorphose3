#!/bin/sh

PREFIX=/usr
MAIN=

#findPrefix
if [ -x /bin/rpm ]
then
  MAIN=`rpm -ql metamorphose3|grep metamorphose3.py`
  if [ -f "$MAIN" ];then
    exec python3 $MAIN "$@"
    exit
  fi
fi
#findPrefixEnd

#run
if [ -d "$PREFIX/share/metamorphose3" ]
then
  exec python3 $PREFIX/share/metamorphose3/metamorphose3.py "$@"
else
  exec python3 src/metamorphose3.py "$@"
fi
